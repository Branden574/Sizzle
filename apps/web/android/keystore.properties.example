# Android release signing — copy to `keystore.properties` (gitignored) and fill in.
# Generate an upload keystore first (do this yourself; it holds passwords):
#
#   keytool -genkey -v -keystore sizzle-upload.jks -alias sizzle-upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Then move sizzle-upload.jks into apps/web/android/ and set the values below.
# storeFile is resolved relative to apps/web/android/.
storeFile=sizzle-upload.jks
storePassword=CHANGE_ME
keyAlias=sizzle-upload
keyPassword=CHANGE_ME
