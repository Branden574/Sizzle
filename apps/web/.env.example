# ── Sizzle web environment ──────────────────────────────────────────────
# Copy to .env, then fill in the anon key. For LOCAL dev, run `supabase start`
# (or `npm run db:start`) and paste the "anon key" it prints.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>
VITE_API_URL=http://localhost:8787
