# PRODUCTION / store build (TestFlight, App Store, Google Play).
# `npm run build` / `cap:sync` / `ios` / `android` bake THIS in — it MUST point at
# the hosted https backend (a LAN IP is unreachable on testers' devices and iOS
# ATS blocks http). Copy to .env.production and fill in. Values are PUBLIC client
# config (the publishable anon key is meant to ship in the client).
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_API_URL=https://<your-api-host>
