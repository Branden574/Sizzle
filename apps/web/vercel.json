{
  "rewrites": [
    {
      "source": "/r/:id",
      "destination": "https://sizzle-chi.vercel.app/r/:id"
    },
    {
      "source": "/u/:handle",
      "destination": "https://sizzle-chi.vercel.app/u/:handle"
    },
    {
      "source": "/b/:id",
      "destination": "https://sizzle-chi.vercel.app/b/:id"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
