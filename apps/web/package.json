{
  "name": "@sizzle/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sizzle web client — watch it, then cook it.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lan": "tsc -b && vite build --mode lan",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "cap:sync": "npm run build && cap sync",
    "ios": "npm run build && cap run ios",
    "android": "npm run build && cap run android",
    "cap:sync:lan": "npm run build:lan && cap sync",
    "ios:lan": "npm run build:lan && cap run ios",
    "android:lan": "npm run build:lan && cap run android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@gsap/react": "^2.1.2",
    "@sizzle/shared": "*",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.97",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.59.16",
    "gsap": "^3.15.0",
    "hls.js": "^1.5.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
