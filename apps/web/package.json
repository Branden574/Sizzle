{
  "name": "@sizzle/web",
  "private": true,
  "version": "1.0.89",
  "type": "module",
  "description": "Sizzle web client — watch it, then cook it.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lan": "tsc -b && vite build --mode lan",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:controls": "node --test src/components/controls.contract.test.mjs",
    "cap:sync": "npm run build && cap sync",
    "ios": "npm run build && cap run ios",
    "android": "npm run build && cap run android",
    "cap:sync:lan": "npm run build:lan && cap sync",
    "ios:lan": "npm run build:lan && cap run ios",
    "android:lan": "npm run build:lan && cap run android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "release:ios": "bash scripts/release-ios.sh",
    "asc:prepare": "node scripts/asc-prepare-version.mjs",
    "asc:submit": "node scripts/asc-submit-for-review.mjs",
    "asc:release": "node scripts/asc-prepare-version.mjs && node scripts/asc-submit-for-review.mjs",
    "release:ios:full": "bash scripts/release-ios.sh && node scripts/asc-prepare-version.mjs && node scripts/asc-submit-for-review.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.3.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capawesome/capacitor-badge": "^8.0.2",
    "@capawesome/capacitor-file-picker": "^8.0.3",
    "@capgo/camera-preview": "^8.11.1",
    "@capgo/capacitor-native-biometric": "^8.4.11",
    "@capgo/capacitor-updater": "^8.51.0",
    "@capgo/capacitor-uploader": "^8.3.3",
    "@gsap/react": "^2.1.2",
    "@revenuecat/purchases-capacitor": "^13.2.3",
    "@sizzle/shared": "*",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.59.16",
    "firebase": "^12.15.0",
    "gsap": "^3.15.0",
    "hls.js": "^1.5.17",
    "lenis": "^1.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tus-js-client": "^4.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ffmpeg-static": "^5.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
