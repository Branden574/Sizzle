# ── Sizzle API environment ──────────────────────────────────────────────
# Copy to .env, then fill in the values below.

PORT=8787
WEB_ORIGIN=http://localhost:5173

# Supabase. For LOCAL dev, run `supabase start` (or `npm run db:start`) and paste
# the "anon key" and "service_role key" it prints. For a hosted project, use the
# keys from your Supabase project's API settings. NEVER commit real keys — keep
# them in .env (which is gitignored).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Video provider: "mock" (no account needed) or "cloudflare".
VIDEO_PROVIDER=mock

# Cloudflare Stream — only needed when VIDEO_PROVIDER=cloudflare.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
