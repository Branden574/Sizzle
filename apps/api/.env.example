# ── Sizzle API environment ──────────────────────────────────────────────
# Copy to .env. The defaults below match a local `supabase start` stack,
# so for local development you can leave this file as-is.

PORT=8787
WEB_ORIGIN=http://localhost:5173

# Supabase — these are the WELL-KNOWN local dev keys printed by `supabase start`.
# They are safe to commit for LOCAL use only. Replace for any hosted environment.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Video provider: "mock" (no account needed) or "cloudflare".
VIDEO_PROVIDER=mock

# Cloudflare Stream — only needed when VIDEO_PROVIDER=cloudflare.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
