# ── Sizzle API environment ──────────────────────────────────────────────
# Copy to .env, then fill in the values below.

PORT=8787
WEB_ORIGIN=http://localhost:5173

# Supabase. For LOCAL dev, run `supabase start` (or `npm run db:start`) and paste
# the "anon key" and "service_role key" it prints. For a hosted project, use the
# keys from your Supabase project's API settings. NEVER commit real keys — keep
# them in .env (which is gitignored).
SUPABASE_URL=http://127.0.0.1:54341
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Video provider: "mock" (no account needed) or "cloudflare".
VIDEO_PROVIDER=mock

# Cloudflare Stream — only needed when VIDEO_PROVIDER=cloudflare.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# Content moderation via OpenAI's moderation model. When unset, moderation falls
# back to the local keyword/link-spam pass only (the app runs fine without it).
OPENAI_API_KEY=

# ── Everything below is OPTIONAL for local dev ──────────────────────────
# Local dev runs without any of these; each feature degrades to a no-op or a
# mock. They are all REQUIRED in production — set them on the Vercel project
# named `sizzle` (which, confusingly, is the API — see docs/ARCHITECTURE.md).
# Names only here. Never put a real value in this file: it is committed.

# Public origin used to build links in outgoing email and share cards.
APP_ORIGIN=https://getsizzle.app

# Cron auth. /internal/* FAILS CLOSED: with this unset every cron route 401s,
# so the five Vercel Cron jobs (publish-scheduled, finalize-videos,
# rollup-watch-ratios, rollup-hashtag-trends, save-nudges) do nothing.
CRON_SECRET=

# Transactional email (Resend). Unset ⇒ email silently no-ops, so a moderated
# user gets no explanation. EMAIL_FROM must be on a verified Resend domain.
RESEND_API_KEY=
EMAIL_FROM=

# Error monitoring. Unset ⇒ captureException is a no-op and 5xx alerts nobody.
SENTRY_DSN=

# Push (Firebase Cloud Messaging). The whole service-account JSON on one line.
# If set but unparseable, every push is a silent no-op while in-app notification
# rows keep appearing — check `push` on GET /health.
FCM_SERVICE_ACCOUNT=

# Stripe Connect (web payments + creator payouts). Unset ⇒ payments run in mock
# mode and no real money moves. Set the secret key and webhook secret TOGETHER.
# GET /health reports `paymentsKeyMode` so test-vs-live is visible from outside.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_V2_API_VERSION=

# Apple IAP verification via RevenueCat (native purchases).
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_AUTH=

# DANGER — must stay unset/false in production. When "true" the IAP verifier
# accepts SANDBOX receipts, which are never charged: anyone on a sandbox Apple ID
# could unlock premium recipes for $0 while creators see phantom sales. Only turn
# it on while App Review is testing purchases, and turn it off immediately after.
# Its live state is visible in the admin dashboard's Security tab.
ALLOW_SANDBOX_IAP=

# One-time secret gating the very first POST /admin/passphrase, so an attacker
# who gets an admin session before setup can't claim the passphrase.
ADMIN_BOOTSTRAP_SECRET=

# Cloudflare Stream Live (live cooking sessions). Separate token from the
# VOD one above; only needed for /live.
CLOUDFLARE_LIVE_INPUT_TOKEN=
