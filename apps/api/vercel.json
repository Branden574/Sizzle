{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-vercel.mjs",
  "crons": [
    {
      "path": "/internal/publish-scheduled",
      "schedule": "* * * * *"
    },
    {
      "path": "/internal/finalize-videos",
      "schedule": "* * * * *"
    },
    {
      "path": "/internal/save-nudges",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/internal/rollup-watch-ratios",
      "schedule": "17,47 * * * *"
    },
    {
      "path": "/internal/rollup-hashtag-trends",
      "schedule": "*/15 * * * *"
    }
  ]
}
