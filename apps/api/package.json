{
  "name": "@sizzle/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sizzle API — Hono backend (auth, feeds, recipes, uploads).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@sizzle/shared": "*",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "hono": "^4.6.12",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
