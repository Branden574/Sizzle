# Holds a Supabase personal access token — never commit.
.mcp.json

# supabase local
supabase/.temp
supabase/.branches
!*.example

# Firebase push config — added locally to the native projects, not committed.
# (Not secret, but kept out of git; the web/Vercel build doesn't use them.)
**/GoogleService-Info.plist
**/google-services.json

# Playwright MCP run artifacts
.playwright-mcp/
.backups/

# Local agent/tool config — holds a Supabase PAT. Never commit.
.codex/
# Scratch renders and stills, not app assets.
*.jpeg

# Local-only: API CLI deploys exclude web/native assets. Committing this would break the frontend build.
.vercelignore
# Vercel CLI local project link
.vercel
